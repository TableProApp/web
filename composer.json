{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tablepro/web",
    "type": "project",
    "description": "The TablePro marketing site: tablepro.app",
    "keywords": [
        "tablepro",
        "marketing-site",
        "laravel",
        "inertia"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^3.0.0-beta",
        "laravel/framework": "^13.1.1",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.8",
        "phiki/phiki": "^2.1.1",
        "spatie/browsershot": "^5.3",
        "spatie/laravel-sitemap": "^8.1",
        "spatie/yaml-front-matter": "^2.1"
    },
    "require-dev": {
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.29.0",
        "mockery/mockery": "^1.6.13",
        "nunomaduro/collision": "^8.9.1",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "npm install"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#fbbf24\" \"php artisan serve\" \"npm run dev\" --names=server,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
