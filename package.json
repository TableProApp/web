{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:proxy": "node scripts/dev-proxy.mjs",
        "build": "vite build && vite build --ssr",
        "ssr:start": "php artisan inertia:start-ssr",
        "ssr:stop": "php artisan inertia:stop-ssr",
        "typecheck": "tsc --noEmit",
        "test:js": "node --experimental-strip-types --test tests/js/*.test.ts",
        "check:shared": "bash scripts/check-shared-files.sh"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@inertiajs/react": "^3.8.0",
        "@inertiajs/vite": "^3.8.0",
        "@tailwindcss/vite": "^4.3.3",
        "clsx": "^2.1.1",
        "lucide-react": "^1.52.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.2"
    }
}
